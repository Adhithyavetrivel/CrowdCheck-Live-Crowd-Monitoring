# CrowdCheck Database Configuration Template
# Copy this file to 'src/main/resources/db.properties' or place 'db.properties' in your working directory.
# You can also override these settings using environment variables:
#   DB_URL, DB_USER, DB_PASSWORD

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/crowdcheck?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.user=root
db.password=your_mysql_password
